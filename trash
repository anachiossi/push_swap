void	reverse_rotate2(t_stack *x)
{
	t_node	*temp;

	if (x->size < 2)
		return ;
	temp = x->bottom;
	x->bottom = temp->prev;
	x->bottom->next = NULL;
	temp->prev = NULL;
	temp->next = x->top;
	x->top->prev = temp;
	x->top = temp;
}

