int	*input_to_array(int size, char **arg_nbr)
{
	int	*arr;
	int	i;

	if (validate_input(arg_nbr) == -1)
		return (NULL);
	arr = (int *)malloc(sizeof(int) * size);
	if (!arr)
		return (NULL);
	i = 0;
	while (i < size)
	{
		arr[i] = ft_atoi(arg_nbr[i]);
		i++;
	}
	if (validate_int_duplicates(arr, size) == -1)
	{
		free(arr);
		return (NULL);
	}
	return (arr);
}

int	validate_int_duplicates(int *arr, int size)
{
	int	i;
	int	j;

	i = 0;
	while (i < size)
	{
		j = i + 1;
		while (j < size)
		{
			if (arr[i] == arr[j])
				return (-1);
			j++;
		}
		i++;
	}
	return (1);
}
	
void	push_bottom(t_stack *stack, t_node *new)
{
	if (!stack || !new)
		return ;
	if (!stack->size)
	{
		stack->top = new;
		stack->bottom = new;
	}
	else
	{
		stack->bottom->next = new;
		stack->bottom = new;
	}
	stack->size += 1;
}
	
reverse, for ra, rb
void	r(t_stack *x)
{
	t_node	*temp;

	if (!x || x->size < 2)
		return ;
	temp = x->top;
	x->top = temp->next;
	x->bottom->next = temp;
	x->bottom = temp;
	temp->next = NULL;
}
// reverse rotate, for rra rrb
void	r_r(t_stack *x)
{
	t_node	*temp;
	t_node	*new_bottom;

	if (x->size < 2)
		return ;
	new_bottom = x->top;
	while (new_bottom->next != x->bottom)
		new_bottom = new_bottom->next;
	temp = x->bottom;
	new_bottom->next = NULL;
	x->bottom = new_bottom;
	temp->next = x->top;
	x->top = temp;
}
