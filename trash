must be integer, no special chars, no empty strings
int	validate_input(char **arg_nbr)
{
	int	i;
	int	j;
	i = 0;
	while (arg_nbr[i])
	{
		j = 0;
		if (arg_nbr[i][j] == '-' || arg_nbr[i][j] == '+')
			j++;
		if (arg_nbr[i][j] == '\0')
			return (-1);
		while (arg_nbr[i][j])
		{
			if (!ft_isdigit(arg_nbr[i][j]))
				return (-1);
			j++;
		}
		i++;
	}
	if (validate_int_limits(arg_nbr) == -1)
		return (-1);
	return (1);
}

int validate_int_limits(char **arg_nbr)
{
	size_t	len;
	char	*ptr;
	int 	i;
	
	i = 0;
	while (arg_nbr[i])
	{
		ptr = arg_nbr[i];
		if (ptr[0] == '-' || ptr[0] == '+')
			ptr++;
		len = ft_strlen(ptr);
		if (len > 10)
			return (-1);
		if (len == 10)
		{
			if (arg_nbr[i][0] == '-' && ft_strncmp(ptr, "2147483648", 10) > 0)
				return (-1);
			if (arg_nbr[i][0] != '-' && ft_strncmp(ptr, "2147483647", 10) > 0)
				return (-1);
		}
		i++;
	}
	return (1);
}

int	*input_to_array(int size, char **arg_nbr)
{
	int	*arr;
	int	i;

	if (validate_input(arg_nbr) == -1)
		return (NULL);
	arr = (int *)malloc(sizeof(int) * size);
	if (!arr)
		return (NULL);
	i = 0;
	while (i < size)
	{
		arr[i] = ft_atoi(arg_nbr[i]);
		i++;
	}
	if (validate_int_duplicates(arr, size) == -1)
	{
		free(arr);
		return (NULL);
	}
	return (arr);
}

int	validate_int_duplicates(int *arr, int size)
{
	int	i;
	int	j;

	i = 0;
	while (i < size)
	{
		j = i + 1;
		while (j < size)
		{
			if (arr[i] == arr[j])
				return (-1);
			j++;
		}
		i++;
	}
	return (1);
}
	
reverse, for ra, rb
void	r(t_stack *x)
{
	t_node	*temp;

	if (!x || x->size < 2)
		return ;
	temp = x->top;
	x->top = temp->next;
	x->bottom->next = temp;
	x->bottom = temp;
	temp->next = NULL;
}
// reverse rotate, for rra rrb
void	r_r(t_stack *x)
{
	t_node	*temp;
	t_node	*new_bottom;

	if (x->size < 2)
		return ;
	new_bottom = x->top;
	while (new_bottom->next != x->bottom)
		new_bottom = new_bottom->next;
	temp = x->bottom;
	new_bottom->next = NULL;
	x->bottom = new_bottom;
	temp->next = x->top;
	x->top = temp;
}
