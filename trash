int	validate_input(char **arg_nbr)
{
	int	i;
	int	j;
	i = 0;
	while (arg_nbr[i])
	{
		j = 0;
		if (arg_nbr[i][j] == '-' || arg_nbr[i][j] == '+')
			j++;
		if (arg_nbr[i][j] == '\0')
